{
  "name": "jansetu-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "JanSetu AI backend — multichannel citizen ingestion, spatial AI, and DPG surface.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/jobs/seedFirestore.ts",
    "backfill:districts": "tsx src/jobs/backfillDistricts.ts",
    "enrich:wikipedia": "tsx src/jobs/enrichWithWikipedia.ts",
    "telegram:webhook": "tsx src/jobs/registerTelegramWebhook.ts"
  },
  "dependencies": {
    "@google/genai": "^0.14.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^13.0.2",
    "h3-js": "^4.1.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
